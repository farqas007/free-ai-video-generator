# Hugging Face Space id hosting an open-source VIDEO model.
# Format: owner/space-name  (community Spaces change often - verify it is up)
HF_SPACE_ID=

# Optional: full base URL override. Falls back to https://<HF_SPACE_ID>.hf.space
HF_SPACE_URL=

# Optional: explicit Gradio function name to call, e.g. /generate or /predict.
# When empty, it is auto-detected from the Space's public openapi.json.
HF_SPACE_API_NAME=

# Optional: free Hugging Face token -> better rate limits on public Spaces.
# Backend ONLY. Never place tokens in frontend code.
HF_SPACE_TOKEN=

# Optional: max milliseconds to wait for a generation before failing.
HF_SPACE_TIMEOUT_MS=600000

# Optional: retries for transient network/rate-limit failures (default 3).
HF_SPACE_RETRIES=3

# Provider to use (default: huggingface-space)
VIDEO_PROVIDER=huggingface-space

# HTTP port
PORT=3000